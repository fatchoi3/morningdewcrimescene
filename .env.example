# ── 환경 변수 예시 ── (`cp .env.example .env` 후 필요 값만 수정)

# 실행 모드: local(기본, 오프라인 단독) | online(B단계 — 방 서버, 미구현)
VITE_MODE=local

# 공개 데모 빌드 여부: 1이면 secrets.demo.js(정답 미포함)로 빌드 + 데모 배너 표시
# (빌드 시 사용:  VITE_DEMO=1 npx vite build)
# VITE_DEMO=1

# B(온라인) 단계에서 방 서버 WebSocket 주소
VITE_WS_URL=wss://api.morningdewcrimescene.site/ws
